pipeline {
    agent any
    stages{
        stage('PULL'){
            steps{
                git branch: 'dev', url: 'https://github.com/Utkarsh-Wanjari/radison-hms-reservation-app.git'
            }
        }
        stage('BUILD'){
            steps{
                sh 'mvn clean package -DskipTests'
            }
        }
        stage('DOCKER-BUILD'){
            steps{
                sh '''docker build . -t utkarsh1313/radison-reservation-app-sk:latest
                        docker push utkarsh1313/radison-reservation-app-sk:latest
                        docker rmi -f utkarsh1313/radison-reservation-app-sk:latest'''
            }
        }
        stage('DEPLOY'){
            steps{
                sh 'kubectl apply -f yaml/'
            }
        }
    }
}
